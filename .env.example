# Copie este archivo como .env y complete los valores (Supabase > Project Settings > API).
# La URL y la PUBLISHABLE KEY se pueden usar en frontend cuando RLS está bien configurado.
# Si su proyecto muestra "anon public key" en lugar de "publishable key", use esa clave aquí.
# NUNCA coloque aquí una Secret Key, service_role ni la contraseña de PostgreSQL.
VITE_SUPABASE_URL=https://SU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
